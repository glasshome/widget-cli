{
  "name": "@glasshome/widget-cli",
  "version": "0.15.4",
  "description": "CLI for creating and managing GlassHome widgets",
  "keywords": [
    "cli",
    "dashboard",
    "glasshome",
    "home-assistant",
    "scaffold",
    "smart-home",
    "widget"
  ],
  "homepage": "https://github.com/glasshome/widget-cli#readme",
  "bugs": {
    "url": "https://github.com/glasshome/widget-cli/issues"
  },
  "license": "MIT",
  "author": "GlassHome Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/glasshome/widget-cli.git"
  },
  "bin": {
    "glasshome-widget": "bin/cli.ts"
  },
  "files": [
    "bin",
    "src",
    "template"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "cli": "bun bin/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check:dead": "fallow dead-code --fail-on-issues",
    "lint": "oxlint --type-aware . && oxfmt --check ."
  },
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "@fontsource-variable/caveat": "^5.2.8",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@glasshome/sync-layer": "0.11.4",
    "@glasshome/widget-contract": "0.3.0",
    "@glasshome/widget-sdk": "1.20.0",
    "@iconify-json/lucide": "^1.2.0",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/utils": "^3.1.4",
    "@tailwindcss/vite": "^4.1.13",
    "iconify-icon": "^3.0.2",
    "open": "^11.0.0",
    "picocolors": "^1.1.1",
    "semver": "^7.6.0",
    "ts-morph": "^28.0.0",
    "vite-plugin-solid": "^2.11.0"
  },
  "devDependencies": {
    "@iconify/types": "^2.0.0",
    "@types/bun": "^1.4.0",
    "@types/semver": "^7.0.0",
    "fallow": "3.17.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "^1.40.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "playwright": "^1.40.0",
    "vite": "^7.3.1"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
