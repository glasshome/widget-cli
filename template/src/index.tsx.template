import {
  Button,
  defineConfig,
  defineWidget,
  field,
  Icon,
  type Infer,
  ResponsiveDialog,
  ResponsiveDialogBody,
  ResponsiveDialogContent,
  ResponsiveDialogDescription,
  ResponsiveDialogFooter,
  ResponsiveDialogHeader,
  ResponsiveDialogTitle,
  SchemaForm,
  Tabs,
  TabsContent,
  TabsList,
  TabsTrigger,
  useEntity,
  useWidgetContext,
  useWidgetDialog,
  Widget,
  WidgetDialog,
} from "@glasshome/widget-sdk";
import { Show } from "solid-js";

const configSchema = defineConfig({
  title: field.title(),
  entityIds: field.entity("sensor"),
});

type WidgetConfig = Infer<typeof configSchema>;

const dialogParts = {
  ResponsiveDialog,
  ResponsiveDialogContent,
  ResponsiveDialogHeader,
  ResponsiveDialogTitle,
  ResponsiveDialogDescription,
  ResponsiveDialogBody,
  ResponsiveDialogFooter,
  Button,
  SchemaForm,
  Tabs,
  TabsList,
  TabsTrigger,
  TabsContent,
} as const;

function WIDGET_NAMEWidget(props: { config: WidgetConfig }) {
  const ctx = useWidgetContext();
  const { setShowDialog, dialogProps } = useWidgetDialog();
  const entity = useEntity(() => props.config.entityIds[0] ?? "");

  const name = () => props.config.title || entity()?.friendlyName || "WIDGET_NAME";

  return (
    <>
      <Widget
        variant="classic-glass"
        tone="info"
        emptyState={
          entity()
            ? undefined
            : {
                icon: <Icon icon="mdi:gauge" width={32} />,
                title: "No sensor",
                message: "Hold to configure",
              }
        }
      >
        <Show when={entity()}>
          {(e) => (
            <Widget.Content>
              <Widget.Glyph icon="mdi:gauge" />
              <Widget.Head icon="mdi:gauge" name={name()} active />
              <Widget.Hero value={e().state} unit={e().unitOfMeasurement ?? undefined} />
            </Widget.Content>
          )}
        </Show>
      </Widget>
      <WidgetDialog
        {...dialogParts}
        {...dialogProps}
        title="WIDGET_NAME"
        configSchema={configSchema}
        config={props.config}
        onConfigSave={(config) => {
          ctx.updateConfig(config);
          setShowDialog(false);
        }}
      />
    </>
  );
}

export default defineWidget<WidgetConfig>({
  manifest: {
    name: "WIDGET_NAME",
    icon: "mdi:gauge",
    minSize: { w: 1, h: 1 },
    maxSize: { w: 8, h: 8 },
    defaultSize: { w: 2, h: 2 },
    sdkVersion: "SDK_RANGE",
    capabilities: [{ domain: "sensor", access: "read" }],
    examples: [
      {
        label: "Living room",
        size: { w: 2, h: 2 },
        config: { title: "Living room", entityIds: ["sensor.temperature_living"] },
      },
      {
        label: "Small",
        size: { w: 1, h: 1 },
        config: { entityIds: ["sensor.temperature_living"] },
      },
    ],
  },
  configSchema,
  component: WIDGET_NAMEWidget,
});
